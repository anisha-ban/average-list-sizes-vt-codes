@misc{beelenReedSolomonCodesInsertions2025,
  title = {Reed-Solomon Codes Against Insertions and Deletions: Full-Length and Rate-\$1/2\$ Codes},
  shorttitle = {Reed-Solomon Codes Against Insertions and Deletions},
  author = {Beelen, Peter and Con, Roni and Gruica, Anina and Montanucci, Maria and Yaakobi, Eitan},
  year = {2025},
  month = jan,
  number = {arXiv:2501.11371},
  eprint = {2501.11371},
  primaryclass = {cs},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2501.11371},
  urldate = {2025-01-22},
  abstract = {The performance of Reed-Solomon codes (RS codes, for short) in the presence of insertion and deletion errors has been studied recently in several papers. In this work, we further study this intriguing mathematical problem, focusing on two regimes. First, we study the question of how well full-length RS codes perform against insertions and deletions. For 2-dimensional RS codes, we fully characterize which codes cannot correct even a single insertion or deletion and show that (almost) all 2-dimensional RS codes correct at least \$1\$ insertion or deletion error. Moreover, for large enough field size \$q\$, and for any \$k {\textbackslash}ge 2\$, we show that there exists a full-length \$k\$-dimensional RS code that corrects \$q/10k\$ insertions and deletions. Second, we focus on rate \$1/2\$ RS codes that can correct a single insertion or deletion error. We present a polynomial time algorithm that constructs such codes for \$q = O(k{\textasciicircum}4)\$. This result matches the existential bound given in {\textbackslash}cite\{con2023reed\}.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Information Theory,Mathematics - Information Theory},
  file = {/home/ge73wor/snap/zotero-snap/common/Zotero/storage/V8V5NGE7/Beelen et al. - 2025 - Reed-Solomon Codes Against Insertions and Deletions Full-Length and Rate-$12$ Codes.pdf;/home/ge73wor/snap/zotero-snap/common/Zotero/storage/NRWKACS6/2501.html}
}

