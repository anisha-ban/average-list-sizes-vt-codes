@article{EulersTotientFunction2026,
  title = {Euler's Totient Function},
  year = 2026,
  month = aug,
  journal = {Wikipedia},
  urldate = {2026-09-07},
  abstract = {In number theory, Euler's totient function counts the positive integers up to a given integer                         n                 \textbraceleft\textbackslash displaystyle n\textbraceright{}     that are relatively prime to                         n                 \textbraceleft\textbackslash displaystyle n\textbraceright{}    . It is written using the Greek letter phi as                         {$\varphi$}         (         n         )                 \textbraceleft\textbackslash displaystyle \textbackslash varphi (n)\textbraceright{}     or                         {$\phi$}         (         n         )                 \textbraceleft\textbackslash displaystyle \textbackslash phi (n)\textbraceright{}    , and may also be called Euler's phi function. In other words, it is the number of integers                         k                 \textbraceleft\textbackslash displaystyle k\textbraceright{}     in the range                         1         {$\leq$}         k         {$\leq$}         n                 \textbraceleft\textbackslash displaystyle 1\textbackslash leq k\textbackslash leq n\textbraceright{}     for which the greatest common divisor                         gcd         (         n         ,         k         )                 \textbraceleft\textbackslash displaystyle \textbackslash gcd(n,k)\textbraceright{}     is equal to 1. The integers                         k                 \textbraceleft\textbackslash displaystyle k\textbraceright{}     of this form are sometimes referred to as totatives of                         n                 \textbraceleft\textbackslash displaystyle n\textbraceright{}    . For example, the totatives of                         n         =         9                 \textbraceleft\textbackslash displaystyle n=9\textbraceright{}     are the six numbers 1, 2, 4, 5, 7 and 8. They are all relatively prime to 9, but the other three numbers in this range, 3, 6, and 9 are not, since                         gcd         (         9         ,         3         )         =         gcd         (         9         ,         6         )         =         3                 \textbraceleft\textbackslash displaystyle \textbackslash gcd(9,3)=\textbackslash gcd(9,6)=3\textbraceright{}     and                         gcd         (         9         ,         9         )         =         9                 \textbraceleft\textbackslash displaystyle \textbackslash gcd(9,9)=9\textbraceright{}    . Therefore,                         {$\varphi$}         (         9         )         =         6                 \textbraceleft\textbackslash displaystyle \textbackslash varphi (9)=6\textbraceright{}    . As another example,                         {$\varphi$}         (         1         )         =         1                 \textbraceleft\textbackslash displaystyle \textbackslash varphi (1)=1\textbraceright{}     since for                         n         =         1                 \textbraceleft\textbackslash displaystyle n=1\textbraceright{}     the only integer in the range from 1 to                         n                 \textbraceleft\textbackslash displaystyle n\textbraceright{}     is 1 itself, and                         gcd         (         1         ,         1         )         =         1                 \textbraceleft\textbackslash displaystyle \textbackslash gcd(1,1)=1\textbraceright{}    . Euler's totient function is a multiplicative function, meaning that if two numbers                         m                 \textbraceleft\textbackslash displaystyle m\textbraceright{}     and                         n                 \textbraceleft\textbackslash displaystyle n\textbraceright{}     are relatively prime, then                         {$\varphi$}         (         m         n         )         =         {$\varphi$}         (         m         )         {$\varphi$}         (         n         )                 \textbraceleft\textbackslash displaystyle \textbackslash varphi (mn)=\textbackslash varphi (m)\textbackslash varphi (n)\textbraceright{}    . This function gives the order of the multiplicative group of integers modulo n (the group of units of the ring                                    Z                             /                  n                    Z                          \textbraceleft\textbackslash displaystyle \textbackslash mathbb \textbraceleft Z\textbraceright{} /n\textbackslash mathbb \textbraceleft Z\textbraceright{} \textbraceright{}    ). It is also used for defining the RSA encryption system.},
  copyright = {Creative Commons Attribution-ShareAlike License},
  langid = {english},
  file = {/home/ge73wor/snap/zotero-snap/common/Zotero/storage/4IHAQ2EB/index.html}
}

