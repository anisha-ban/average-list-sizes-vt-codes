@article{wachter-zehListDecodingInsertions2018,
  title = {List Decoding of Insertions and Deletions},
  author = {{Wachter-Zeh}, Antonia},
  year = 2018,
  month = sep,
  journal = {IEEE Transactions on Information Theory},
  volume = {64},
  number = {9},
  pages = {6297--6304},
  issn = {1557-9654},
  doi = {10.1109/TIT.2017.2777471},
  abstract = {List decoding of insertions and deletions in the Levenshtein metric is considered. The Levenshtein distance between two sequences is the minimum number of insertions and deletions needed to turn one of the sequences into the other. In this paper, a Johnson-like upper bound on the maximum list size when list decoding in the Levenshtein metric is derived. This bound depends only on the length and minimum Levenshtein distance of the code, the length of the received word, and the alphabet size. It shows that polynomial-time list decoding beyond half the Levenshtein distance is possible for many parameters. Further, we also prove a lower bound on list decoding of deletions with the well-known binary Varshamov-Tenengolts codes, which shows that the maximum list size grows exponentially with the number of deletions. Finally, an efficient list decoding algorithm for two insertions/deletions with VT codes is given. This decoder can be modified to a polynomial-time list decoder of any constant number of insertions/deletions.},
  keywords = {Complexity theory,Decoding,deletions,DNA,Hamming distance,Indexes,Insertions,Levenshtein metric,list decoding,Measurement,Upper bound,Varshamov-Tenengolts (VT) codes},
  file = {/home/ge73wor/snap/zotero-snap/common/Zotero/storage/B769ZKB6/Wachter-Zeh_2018_List Decoding of Insertions and Deletions.pdf}
}

